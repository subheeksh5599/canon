# CANON environment (all optional for local runs — the engine works on local Sibyl alone)
# Copy to .env and fill only what you need. NEVER commit this file.

# Where CANON keeps its Sibyl memory database
CANON_DB_PATH=/tmp/canon-market.db

# Base Sepolia deployment (deploy step only)
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Deployer private key — set in the environment, never in a file in this repo
# DEPLOYER_KEY=

# Venue + adjudicator addresses passed to CanonMarket constructor
CANON_VENUE_ADDRESS=0x0000000000000000000000000000000000000000
CANON_ADJUDICATOR_ADDRESS=0x0000000000000000000000000000000000000000

# Doctrine knobs (defaults shown)
CANON_EVIDENCE_THRESHOLD_ACTIVATE=5
CANON_DECAY_WEAKENING_DAYS=30
CANON_DECAY_ARCHIVE_DAYS=90
CANON_STATUTE_DAYS=90
